# LLM configuration — any OpenAI-compatible endpoint
ECOM_LLM_API_KEY=your_api_key_here
ECOM_LLM_BASE_URL=https://api.openai.com/v1
ECOM_LLM_MODEL=gpt-4o-mini

# DeepSeek thinking models: strip hidden reasoning for ~7x faster structured calls
# (leave unset for OpenAI and providers that reject the `thinking` parameter)
# ECOM_LLM_DISABLE_THINKING=true

# Pipeline tuning (optional)
# ECOM_MAX_PRODUCTS=3
# ECOM_MAX_CANDIDATES=12

# LangSmith tracing (optional)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_key
