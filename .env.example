# LLM — any OpenAI-compatible endpoint
ECOM_LLM_API_KEY=your_api_key_here
ECOM_LLM_BASE_URL=https://api.openai.com/v1
ECOM_LLM_MODEL=gpt-4o-mini

# Some providers (e.g. DeepSeek reasoning models) reject forced tool_choice or are
# much slower with hidden reasoning on. Set this to strip it (measured 10s -> 1.4s).
# ECOM_LLM_DISABLE_THINKING=true

# Where downloaded data, the generated catalogue and local models live.
# Defaults to <repo>/data
# ECOM_DATA_DIR=/absolute/path/to/data

# auto (default) = generated catalogue when present, else the built-in demo one
# real           = require the generated catalogue, fail fast
# mock           = always use the built-in demo catalogue
# ECOM_DATA_SOURCE=auto

# ECOM_MAX_PRODUCTS=3      # products shown per turn
# ECOM_MAX_CANDIDATES=12   # candidates kept after recall
# ECOM_CURRENCY=CNY

# Agent loop budgets for one shopper turn (the RL episodes use SHOPRL_* below)
# ECOM_MAX_TURNS=8
# ECOM_MAX_TOOL_CALLS=12
# ECOM_LLM_MAX_TOKENS=1200

# ---------------------------------------------------------------------------
# Training stack (src/shoprl). All optional; the defaults are single-GPU sane.
# ---------------------------------------------------------------------------

# Point rollouts at the official ShopSimulator Flask service instead of the
# in-process environment. Leave empty to use the built-in one.
# SHOPRL_ENV_URL=http://127.0.0.1:5000/api/shop_agent

# SHOPRL_ENV_POOL_CAPACITY=8      # one environment per in-flight episode
# SHOPRL_MAX_MODEL_TURNS=30
# SHOPRL_MAX_TOOL_CALLS=60
# SHOPRL_MAX_CONTEXT_TOKENS=16384
# SHOPRL_MAX_RESPONSE_TOKENS=1024
# SHOPRL_CONTEXT_KEEP_TOOL_RESULTS=3
# SHOPRL_PERSONA=false            # show the shopper's profile on reset
